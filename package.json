{
  "name": "master-data-service",
  "version": "0.0.1",
  "type": "module",
  "description": "Arunika Coffee API Master Data Service",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.18.0",
  "engines": { "node": "22.x" },
  "scripts": {
    "build": "nest build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "fresh": "bash scripts/fresh-install.sh",
    "clean:hard": "bash scripts/hard-clean.sh",
    "clean:soft": "bash scripts/soft-clean.sh",
    "clean": "rm -rf dist node_modules/.cache generated tsconfig.build.tsbuildinfo && npm run clean:soft",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "prisma generate && tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" --no-error-on-unmatched-pattern",
    "test": "prisma generate && vitest run",
    "test:watch": "prisma generate && vitest",
    "test:unit": "prisma generate && vitest run --config vitest.config.ts",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.ts",
    "test:e2e": "prisma generate && vitest run --config vitest.e2e.config.ts",
    "test:grpc": "prisma generate && vitest run --config vitest.grpc.config.ts",
    "test:security": "prisma generate && vitest run --config vitest.security.config.ts",
    "test:coverage": "prisma generate && vitest run --coverage",
    "test:coverage:e2e": "prisma generate && vitest run --config vitest.e2e.config.ts --coverage",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:grpc && npm run test:security",
    "test:steps:26-45": "bash scripts/verify-steps-26-45-v2.sh",
    "test:steps:51-55": "bash scripts/verify-steps-51-55.sh",
    "test:steps:56-60": "bash scripts/verify-steps-56-60.sh",
    "check:fix": "npm run format && npm run lint:fix",
    "check:health": "npm run lint && npm run typecheck && npm run test && npm run format:check && npm run build",
    "check:fresh": "npm run clean && npm ci && npm run check:health"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@grpc/reflection": "1.0.4",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/microservices": "11.2.1",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "grpc-health-check": "2.1.0",
    "mariadb": "3.5.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.18.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
