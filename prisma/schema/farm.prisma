model Farm {
  /**
   * Identity
   */
  id String @id @default(cuid())

  uuid String @unique @default(uuid())

  /**
   * Basic Information
   */
  name String

  /**
   * Geographic Relationship
   */
  farmerId String

  /**
   * Farm Information
   */
  area Float?

  areaUnit String? @default("hectare")

  establishedYear Int?

  /**
   * Elevation Information
   */
  altitudeMin Int?

  altitudeMax Int?

  altitudeUnit String? @default("MASL")

  /**
   * Geographic Coordinate
   */
  latitude Float?

  longitude Float?

  /**
   * Terroir Information
   */
  soilType String?

  climate String?

  /**
   * Farming Practice
   */
  farmingPractice String?

  /**
   * Content Information
   */
  description String?

  /**
   * Relations
   */

  farmer Farmer @relation(fields: [farmerId], references: [id])

  /**
   * Status
   */
  isActive Boolean @default(true)

  sortOrder Int @default(0)

  /**
   * Timestamps
   */
  createdAt DateTime @default(now())

  updatedAt   DateTime     @updatedAt
  coffeeBeans CoffeeBean[]

  @@index([farmerId])
  @@map("farms")
}
