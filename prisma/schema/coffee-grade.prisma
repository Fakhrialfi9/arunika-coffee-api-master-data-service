model CoffeeGrade {
  /**
   * Identity
   */
  id String @id @default(cuid())

  uuid String @unique @default(uuid())

  /**
   * Basic Information
   */
  code String @unique

  name String

  category String?

  /**
   * Quality Standard
   */
  standard String?

  minimumCuppingScore Float?

  maxDefectCount Int?

  /**
   * Export Information
   */
  exportEligible Boolean @default(false)

  /**
   * Content Information
   */
  description String?

  /**
   * Status
   */
  isActive Boolean @default(true)

  sortOrder Int @default(0)

  /**
   * Timestamps
   */
  createdAt DateTime @default(now())

  updatedAt   DateTime     @updatedAt
  coffeeBeans CoffeeBean[]

  @@map("coffee_grades")
}
