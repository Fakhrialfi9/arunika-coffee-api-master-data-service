generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Country {
  id             String   @id @db.VarChar(191)
  uuid           String   @unique @db.VarChar(191)
  code           String   @unique @db.VarChar(191)
  name           String   @db.VarChar(191)
  officialName   String?  @db.VarChar(191)
  shortName     String?  @db.VarChar(191)
  iso2           String   @unique @db.VarChar(191)
  iso3           String   @unique @db.VarChar(191)
  continent      String?  @db.VarChar(191)
  timezone       String?  @db.VarChar(191)
  phoneCode      String?  @db.VarChar(191)
  currency       String?  @db.VarChar(191)
  currencyCode   String?  @db.VarChar(191)
  isCoffeeOrigin Boolean  @default(false)
  description    String?  @db.VarChar(191)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  regions Region[]

  @@map("countries")
}

model Region {
  id           String   @id @db.VarChar(191)
  uuid         String   @unique @db.VarChar(191)
  countryId    String   @db.VarChar(191)
  code         String   @unique @db.VarChar(191)
  name         String   @db.VarChar(191)
  type         String?  @db.VarChar(191)
  province     String?  @db.VarChar(191)
  district     String?  @db.VarChar(191)
  city         String?  @db.VarChar(191)
  village      String?  @db.VarChar(191)
  latitude     Float?
  longitude    Float?
  altitudeMin  Int?
  altitudeMax  Int?
  altitudeUnit String?  @default("MASL") @db.VarChar(191)
  climate      String?  @db.VarChar(191)
  soilType     String?  @db.VarChar(191)
  description  String?  @db.VarChar(191)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  country       Country        @relation(fields: [countryId], references: [id])
  farmers       Farmer[]
  organizations Organization[]
  coffeeBeans   CoffeeBean[]

  @@index([countryId])
  @@map("regions")
}

model Organization {
  id              String   @id @db.VarChar(191)
  uuid            String   @unique @db.VarChar(191)
  code            String   @unique @db.VarChar(191)
  name            String   @db.VarChar(191)
  type            String   @db.VarChar(191)
  regionId        String   @db.VarChar(191)
  contactName     String?  @db.VarChar(191)
  phone           String?  @db.VarChar(191)
  email           String?  @db.VarChar(191)
  establishedYear Int?
  memberCount     Int?
  description     String?  @db.VarChar(191)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  region  Region   @relation(fields: [regionId], references: [id])
  farmers Farmer[]

  @@index([regionId])
  @@map("organizations")
}

model Farmer {
  id               String   @id @db.VarChar(191)
  uuid             String   @unique @db.VarChar(191)
  code             String   @unique @db.VarChar(191)
  name             String   @db.VarChar(191)
  type             String   @db.VarChar(191)
  regionId         String   @db.VarChar(191)
  organizationId   String?  @db.VarChar(191)
  contactName      String?  @db.VarChar(191)
  phone            String?  @db.VarChar(191)
  email            String?  @db.VarChar(191)
  farmingSinceYear Int?
  description      String?  @db.VarChar(191)
  story            String?  @db.VarChar(191)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  region       Region        @relation(fields: [regionId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  farms        Farm[]
  coffeeBeans  CoffeeBean[]

  @@index([regionId])
  @@index([organizationId])
  @@map("farmers")
}

model Farm {
  id              String   @id @db.VarChar(191)
  uuid            String   @unique @db.VarChar(191)
  name            String   @db.VarChar(191)
  farmerId        String   @db.VarChar(191)
  area            Float?
  areaUnit        String?  @default("hectare") @db.VarChar(191)
  establishedYear Int?
  altitudeMin     Int?
  altitudeMax     Int?
  altitudeUnit    String?  @default("MASL") @db.VarChar(191)
  latitude        Float?
  longitude       Float?
  soilType        String?  @db.VarChar(191)
  climate         String?  @db.VarChar(191)
  farmingPractice String?  @db.VarChar(191)
  description     String?  @db.VarChar(191)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  farmer      Farmer      @relation(fields: [farmerId], references: [id])
  coffeeBeans CoffeeBean[]

  @@index([farmerId])
  @@map("farms")
}

model Species {
  id             String   @id @db.VarChar(191)
  uuid           String   @unique @db.VarChar(191)
  code           String   @unique @db.VarChar(191)
  name           String   @db.VarChar(191)
  commonName     String?  @db.VarChar(191)
  scientificName String?  @db.VarChar(191)
  originRegion   String?  @db.VarChar(191)
  description    String?  @db.VarChar(191)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  varieties   Variety[]
  coffeeBeans CoffeeBean[]

  @@map("species")
}

model Variety {
  id                  String   @id @db.VarChar(191)
  uuid                String   @unique @db.VarChar(191)
  speciesId           String   @db.VarChar(191)
  code                String   @unique @db.VarChar(191)
  name                String   @db.VarChar(191)
  geneticBackground   String?  @db.VarChar(191)
  originCountry       String?  @db.VarChar(191)
  plantCharacteristics Json?
  flavorCharacteristics Json?
  description         String?  @db.VarChar(191)
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  species     Species      @relation(fields: [speciesId], references: [id])
  coffeeBeans CoffeeBean[]

  @@index([speciesId])
  @@map("varieties")
}

model ProcessingMethod {
  id                   String   @id @db.VarChar(191)
  uuid                 String   @unique @db.VarChar(191)
  code                 String   @unique @db.VarChar(191)
  name                 String   @db.VarChar(191)
  category             String?  @db.VarChar(191)
  fermentation         Boolean  @default(false)
  fermentationType     String?  @db.VarChar(191)
  fermentationDuration String?  @db.VarChar(191)
  dryingMethod         String?  @db.VarChar(191)
  dryingDuration       String?  @db.VarChar(191)
  processingSteps      Json?
  parameters           Json?
  description          String?  @db.VarChar(191)
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  coffeeBeans CoffeeBean[]

  @@map("processing_methods")
}

model CoffeeGrade {
  id                  String   @id @db.VarChar(191)
  uuid                String   @unique @db.VarChar(191)
  code                String   @unique @db.VarChar(191)
  name                String   @db.VarChar(191)
  category            String?  @db.VarChar(191)
  standard            String?  @db.VarChar(191)
  minimumCuppingScore Float?
  maxDefectCount      Int?
  exportEligible      Boolean  @default(false)
  description         String?  @db.VarChar(191)
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  coffeeBeans CoffeeBean[]

  @@map("coffee_grades")
}

model HarvestSeason {
  id          String   @id @db.VarChar(191)
  uuid        String   @unique @db.VarChar(191)
  name        String   @db.VarChar(191)
  label       String?  @db.VarChar(191)
  year        Int
  seasonType  String?  @db.VarChar(191)
  startMonth  Int?
  endMonth    Int?
  isCurrent   Boolean  @default(false)
  description String?  @db.VarChar(191)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coffeeBeans CoffeeBean[]

  @@index([year])
  @@map("harvest_seasons")
}

model FlavorProfile {
  id          String   @id @db.VarChar(191)
  uuid        String   @unique @db.VarChar(191)
  code        String   @unique @db.VarChar(191)
  name        String   @db.VarChar(191)
  category    String?  @db.VarChar(191)
  description String?  @db.VarChar(191)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sensoryProfileFlavors SensoryProfileFlavor[]

  @@map("flavor_profiles")
}

model SensoryProfile {
  id           String   @id @db.VarChar(191)
  uuid         String   @unique @db.VarChar(191)
  coffeeBeanId String   @unique @db.VarChar(191)
  cuppingScore Float?
  aroma        String?  @db.VarChar(191)
  body         String?  @db.VarChar(191)
  acidity      String?  @db.VarChar(191)
  sweetness    String?  @db.VarChar(191)
  aftertaste   String?  @db.VarChar(191)
  description  String?  @db.VarChar(191)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coffeeBean          CoffeeBean             @relation(fields: [coffeeBeanId], references: [id])
  sensoryProfileFlavors SensoryProfileFlavor[]

  @@map("sensory_profiles")
}

model SensoryProfileFlavor {
  id               String   @id @db.VarChar(191)
  uuid             String   @unique @db.VarChar(191)
  sensoryProfileId String   @db.VarChar(191)
  flavorProfileId  String   @db.VarChar(191)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sensoryProfile SensoryProfile @relation(fields: [sensoryProfileId], references: [id])
  flavorProfile  FlavorProfile  @relation(fields: [flavorProfileId], references: [id])

  @@unique([sensoryProfileId, flavorProfileId])
  @@index([sensoryProfileId])
  @@index([flavorProfileId])
  @@map("sensory_profile_flavors")
}

model Certification {
  id                 String   @id @db.VarChar(191)
  uuid               String   @unique @db.VarChar(191)
  code               String   @unique @db.VarChar(191)
  name               String   @db.VarChar(191)
  type               String?  @db.VarChar(191)
  issuer             String?  @db.VarChar(191)
  website            String?  @db.VarChar(191)
  countryScope       String?  @db.VarChar(191)
  requiresExpiration Boolean  @default(false)
  description        String?  @db.VarChar(191)
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("certifications")
}

model CoffeeBean {
  id                 String   @id @db.VarChar(191)
  uuid               String   @unique @db.VarChar(191)
  code               String   @unique @db.VarChar(191)
  lotNumber          String?  @db.VarChar(191)
  name               String   @db.VarChar(191)
  description        String?  @db.VarChar(191)
  regionId           String   @db.VarChar(191)
  farmerId           String?  @db.VarChar(191)
  farmId             String?  @db.VarChar(191)
  speciesId          String   @db.VarChar(191)
  varietyId          String?  @db.VarChar(191)
  processingMethodId String   @db.VarChar(191)
  gradeId            String?  @db.VarChar(191)
  harvestSeasonId    String?  @db.VarChar(191)
  cuppingScore       Float?
  moisture           Float?
  density            Float?
  beanSize           String?  @db.VarChar(191)
  qualityStatus      String?  @db.VarChar(191)
  flavorProfiles     Json?
  aromaNotes         Json?
  availableWeight    Float?
  reservedWeight     Float?
  weightUnit         String   @default("kg") @db.VarChar(191)
  isFeatured         Boolean  @default(false)
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  region          Region           @relation(fields: [regionId], references: [id])
  farmer          Farmer?          @relation(fields: [farmerId], references: [id])
  farm            Farm?            @relation(fields: [farmId], references: [id])
  species         Species          @relation(fields: [speciesId], references: [id])
  variety         Variety?         @relation(fields: [varietyId], references: [id])
  processingMethod ProcessingMethod @relation(fields: [processingMethodId], references: [id])
  grade           CoffeeGrade?     @relation(fields: [gradeId], references: [id])
  harvestSeason   HarvestSeason?   @relation(fields: [harvestSeasonId], references: [id])
  sensoryProfile  SensoryProfile?

  @@index([regionId])
  @@index([farmerId])
  @@index([farmId])
  @@index([speciesId])
  @@map("coffee_beans")
}
